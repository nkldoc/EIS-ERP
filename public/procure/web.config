<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <location path="FileUploadServletJson">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- 1 GiB file plus 1 MiB multipart overhead. -->
          <requestLimits maxAllowedContentLength="1074790400" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
