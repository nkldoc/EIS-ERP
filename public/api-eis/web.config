<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="PR API friendly URL" stopProcessing="true">
                    <match url="^PR/?$" />
                    <action type="Rewrite" url="PR.php" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
