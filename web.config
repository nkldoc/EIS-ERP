<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!-- Never expose application code or writable runtime data. -->
        <rule name="Block private directories" stopProcessing="true">
          <match url="^(?:app|storage)(?:/|$)" ignoreCase="true" />
          <action type="CustomResponse"
                  statusCode="404"
                  statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!-- Block dot-files such as .env, while allowing ACME challenges. -->
        <rule name="Block hidden files" stopProcessing="true">
          <match url="(^|/)\.(?!well-known(?:/|$)).*" ignoreCase="true" />
          <action type="CustomResponse"
                  statusCode="404"
                  statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!-- Keep requests already mapped into public from being rewritten twice. -->
        <rule name="Serve public directory" stopProcessing="true">
          <match url="^public(?:/|$)(.*)" ignoreCase="true" />
          <action type="None" />
        </rule>

        <!-- Treat /public as the logical document root. -->
        <rule name="Public document root" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="public/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="storage" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <handlers>
      <remove name="PHP-FastCGI" />
      <add name="PHP-FastCGI"
           path="*.php"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe"
           resourceType="Either"
           requireAccess="Script" />
    </handlers>
  </system.webServer>
</configuration>
