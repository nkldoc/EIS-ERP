<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Procure portal login" stopProcessing="true">
          <match url="^access/login_1/?$" ignoreCase="true" />
          <action type="Rewrite" url="access/login_1.php" appendQueryString="true" />
        </rule>
        <rule name="Production Incoming Endpoint Management" stopProcessing="true">
          <match url="^incomingEndpoints(?:/(?:users|logs(?:/[1-9][0-9]*)?|[1-9][0-9]*))?/?$" />
          <action type="Rewrite" url="incomingEndpoints.php" appendQueryString="true" />
        </rule>
        <rule name="Production Incoming Account Management" stopProcessing="true">
          <match url="^apiAccounts(?:/[1-9][0-9]*)?/?$" />
          <action type="Rewrite" url="apiAccounts.php" appendQueryString="true" />
        </rule>
        <rule name="Production Outgoing Endpoint Management" stopProcessing="true">
          <match url="^endpoints(?:/(?:databases|preview|[1-9][0-9]*(?:/test)?))?/?$" />
          <action type="Rewrite" url="endpoints.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
