<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Production Incoming JSON Receiver" stopProcessing="true">
          <match url="^[a-zA-Z0-9_-]+(?:/[a-zA-Z0-9_-]+)*/?$" />
          <action type="Rewrite" url="receiver.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
