<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <rule name="Contract backdate request endpoint" stopProcessing="true">
                    <match url="^sp/tor/api/contractBackdateRequest/?$" ignoreCase="true" />
                    <action type="Rewrite" url="sp/tor/api/contractBackdateRequest.php" appendQueryString="true" />
                </rule>
                <rule name="Supplies portal login endpoint" stopProcessing="true">
                    <match url="^access/login_1/?$" ignoreCase="true" />
                    <action type="Rewrite" url="access/login_1.php" appendQueryString="true" />
                </rule>
                <rule name="Supplies login approval endpoint" stopProcessing="true">
                    <match url="^access/login-approval/?$" ignoreCase="true" />
                    <action type="Rewrite" url="access/login-approval.php" appendQueryString="true" />
                </rule>
                <rule name="Supplies login confirmation endpoint" stopProcessing="true">
                    <match url="^access/confirm-login/?$" ignoreCase="true" />
                    <action type="Rewrite" url="access/confirm-login.php" appendQueryString="true" />
                </rule>
                <rule name="Supplies impersonation endpoint" stopProcessing="true">
                    <match url="^access/impersonate/?$" ignoreCase="true" />
                    <action type="Rewrite" url="access/impersonate.php" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        <httpErrors>
            <remove statusCode="404" subStatusCode="-1" />
            <error statusCode="404" prefixLanguageFilePath="" path="/404.html" responseMode="ExecuteURL" />
        </httpErrors>
    </system.webServer>
</configuration>
